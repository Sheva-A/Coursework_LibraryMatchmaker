@page "{id:int?}"
@model LibraryMatchmaker.Pages.Authors.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Новий автор" : "Редагування автора";
}

<h1>@ViewData["Title"]</h1>

<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="Item.AuthorId" />

    <div class="mb-3">
        <label asp-for="Item.LastName" class="form-label">Прізвище</label>
        <input asp-for="Item.LastName" class="form-control" />
        <span asp-validation-for="Item.LastName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Item.FirstName" class="form-label">Ім'я</label>
        <input asp-for="Item.FirstName" class="form-control" />
        <span asp-validation-for="Item.FirstName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Item.BirthYear" class="form-label">Рік народження</label>
        <input asp-for="Item.BirthYear" class="form-control" />
        <span asp-validation-for="Item.BirthYear" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Item.Country" class="form-label">Країна</label>
        <input asp-for="Item.Country" class="form-control" />
        <span asp-validation-for="Item.Country" class="text-danger"></span>
    </div>

    <partial name="_FormButtons" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
