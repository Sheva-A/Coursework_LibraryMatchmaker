@page
@model LibraryMatchmaker.Pages.Readers.IndexModel
@{
    ViewData["Title"] = "Читачі";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Читачі</h1>
    <a class="btn btn-primary" asp-page="Edit">Додати читача</a>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr><th>Читач</th><th>Телефон</th><th>Email</th><th>Зареєстрований</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var reader in Model.Readers)
        {
            <tr>
                <td><a asp-page="Details" asp-route-id="@reader.ReaderId">@reader.LastName @reader.FirstName</a></td>
                <td class="text-nowrap">@reader.Phone</td>
                <td>@reader.Email</td>
                <td>@Fmt.Date(reader.RegistrationDate)</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@reader.ReaderId">Редагувати</a>
                    <partial name="_DeleteButton" model="reader.ReaderId" />
                </td>
            </tr>
        }
    </tbody>
</table>
