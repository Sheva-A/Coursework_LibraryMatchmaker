@{
    // Підсвічує пункт меню поточного розділу
    string Active(params string[] folders) =>
        folders.Any(f => (ViewContext.RouteData.Values["page"] as string ?? "").StartsWith(f)) ? "active" : "";
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Книжковий матчмейкер</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light mb-4">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">Книжковий матчмейкер</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link @Active("/Books")" asp-page="/Books/Index">Каталог</a></li>
                        <li class="nav-item"><a class="nav-link @Active("/Readers")" asp-page="/Readers/Index">Читачі</a></li>
                        <li class="nav-item"><a class="nav-link @Active("/Loans")" asp-page="/Loans/Index">Видачі</a></li>
                        <li class="nav-item"><a class="nav-link @Active("/Reviews")" asp-page="/Reviews/Index">Відгуки</a></li>
                        <li class="nav-item"><a class="nav-link @Active("/Statistics")" asp-page="/Statistics/Index">Статистика</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @Active("/Authors", "/Publishers", "/Genres")" href="#"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">Довідники</a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-page="/Authors/Index">Автори</a></li>
                                <li><a class="dropdown-item" asp-page="/Publishers/Index">Видавництва</a></li>
                                <li><a class="dropdown-item" asp-page="/Genres/Index">Жанри</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @* Повідомлення після збереження, видалення або помилки *@
            @if (TempData["Message"] is string message)
            {
                <div class="alert alert-success">@message</div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger">@error</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-center">
        <div class="container">Курсова робота з БД · Шевченко Анна, ТЦР-31</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
